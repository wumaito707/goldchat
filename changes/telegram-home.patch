--- a/static/styles.css
+++ b/static/styles.css
@@ -128,6 +128,28 @@
 .search-box svg { width: 16px; height: 16px; color: var(--text-faint); flex-shrink: 0; }
 .search-box input { flex: 1; background: none; border: none; outline: none; color: var(--text); font-size: 14px; }
 .search-box input::placeholder { color: var(--text-faint); }
+
+.story-rail {
+  display:flex; gap:12px; overflow-x:auto; padding:10px 14px 8px;
+  border-bottom:1px solid var(--black-3); scrollbar-width:thin;
+}
+.story-item {
+  flex:0 0 62px; width:62px; display:flex; flex-direction:column; align-items:center; gap:5px;
+  border:0; background:none; color:var(--text-dim); cursor:pointer; padding:0;
+}
+.story-avatar {
+  width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center;
+  overflow:hidden; background:linear-gradient(135deg,var(--gold-bright),var(--gold-dim));
+  color:#1a1a1a; font-weight:700; border:2px solid var(--black-1);
+}
+.story-item.has-story .story-avatar {outline:2px solid var(--gold);}
+.story-avatar img {width:100%; height:100%; object-fit:cover;}
+.story-label {font-size:11px; max-width:62px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
+.story-item:hover,.story-item:focus-visible {color:var(--gold-bright);}
+.chat-filters {display:flex; gap:5px; padding:8px 12px; overflow-x:auto; border-bottom:1px solid var(--black-3); scrollbar-width:thin;}
+.chat-filter {flex:0 0 auto; border:0; border-radius:16px; padding:6px 10px; background:var(--black-2); color:var(--text-dim); cursor:pointer; font-size:12px;}
+.chat-filter:hover {color:var(--text);}
+.chat-filter.active {background:var(--gold); color:#1a1a1a; font-weight:700;}
 
 .chat-list { flex: 1; overflow-y: auto; }
 .chat-list::-webkit-scrollbar { width: 6px; }
